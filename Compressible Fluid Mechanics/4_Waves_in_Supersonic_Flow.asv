%%
clear % Clears workspace
clc % Clears command window
close all % Closes all figures
%%
%[text] ## Problem 1. Shock Wave Propagation
%[text] ### Problem Statement
%[text] A Mach 3 shock wave propagates to the right along a shock tube and then collides with the closed end of the tube.  The initial pressure of the gas is p1.  Draw the x-t diagram.  What is the pressure on the end of the tube after the wave arrives?  (*Hint:*  The boundary condition of zero speed at the end of the tube can be satisfied by adding a virtual wave of identical strength propagating to the left.)
%%
%[text] ### Analysis
%[text] <u>Given:</u>
%[text] $M\_s = 3, \\quad \\gamma = 1.4$
%[text] The normal-shock pressure relation is
%[text] $\\frac{p\_2}{p\_1} =1+\\frac{2\\gamma}{\\gamma+1}(M\_s^2-1)$
%[text] Substituting:
%[text] $\\frac{p\_2}{p\_1} =1+\\frac{2(1.4)}{2.4}(3^2-1)$
%[text] Therefore,
%[text] $p\_2=10.333p\_1$
%[text] The first shock raises the pressure to approximately 10.33 times the original value.
%[text] <u>x-t diagram</u>:

%% Mach 3 Shock Reflection - x-t Diagram
% Incident shock travels right and reflects from a rigid wall.
% Horizontal axis: position x
% Vertical axis: time t
%
% Assumptions:
%   Air, gamma = 1.4
%   Initially stationary gas
%   Incident shock Mach number Ms = 3

clear; clc; close all;

%% 1. Gas and shock properties
gamma = 1.4;
Ms = 3;

a1 = 343;           % Initial speed of sound [m/s]
L = 1.0;            % Tube length [m]

% Incident shock speed (laboratory frame)
Vs = Ms*a1;

% State 2: behind incident shock
p2_p1 = 1 + 2*gamma/(gamma+1)*(Ms^2-1);

rho2_rho1 = ((gamma+1)*Ms^2)/ ...
            ((gamma-1)*Ms^2+2);

u2 = Vs*(1-1/rho2_rho1);

% Speed of sound behind incident shock
a2 = a1*sqrt(p2_p1/rho2_rho1);

%% 2. Reflected shock properties
% Reflected shock must bring the gas to rest: u3 = 0

K = (gamma+1)*u2/(2*a2);

% Solve MR - 1/MR = K
MR = (K + sqrt(K^2+4))/2;

% Reflected shock speed in laboratory frame
Vr = u2 - MR*a2;     % Negative = moving left

% Pressure behind reflected shock
p3_p2 = 1 + 2*gamma/(gamma+1)*(MR^2-1);
p3_p1 = p2_p1*p3_p2;

%% 3. Shock trajectories
% Incident shock begins at x = 0, t = 0
% Reflection occurs at x = L

tR = L/Vs;           % Time shock reaches wall
tEnd = 1.8*tR;       % Plot beyond reflection

tIncident = linspace(0,tR,200);
xIncident = Vs*tIncident;

tReflected = linspace(tR,tEnd,200);
xReflected = L + Vr*(tReflected-tR);

%% 4. Plot x-t diagram
figure('Color','w','Position',[150 100 850 650]); %[output:2f493917]
hold on; box on; %[output:2f493917]

% Incident shock
h1 = plot(xIncident,1e3*tIncident, ... %[output:2f493917]
    'LineWidth',2.8,'Color',[0.90 0.42 0.12]); %[output:2f493917]

% Reflected shock
h2 = plot(xReflected,1e3*tReflected, ... %[output:2f493917]
    'LineWidth',2.8,'Color',[0.10 0.50 0.72]); %[output:2f493917]

% Closed wall
h3 = xline(L,'k--','LineWidth',1.8); %[output:2f493917]

% Reflection point
h4 = plot(L,1e3*tR,'ko', ... %[output:2f493917]
    'MarkerFaceColor','k','MarkerSize',7); %[output:2f493917]

%% 5. Region labels
text(0.75*L,0.35*1e3*tR, ... %[output:2f493917]
    {'State 1','p_1, u_1 = 0'}, ... %[output:2f493917]
    'HorizontalAlignment','center','FontSize',12); %[output:2f493917]

text(0.30*L,0.90*1e3*tR, ... %[output:2f493917]
    {'State 2','p_2 = 10.33p_1'}, ... %[output:2f493917]
    'HorizontalAlignment','center','FontSize',12); %[output:2f493917]

text(0.85*L,1.48*1e3*tR, ... %[output:2f493917]
    {'State 3','p_3 = 51.67p_1','u_3 = 0'}, ... %[output:2f493917]
    'HorizontalAlignment','center','FontSize',12); %[output:2f493917]

% Reflection annotation
text(L-0.03,1e3*tR+0.04, ... %[output:2f493917]
    'Reflection', ... %[output:2f493917]
    'HorizontalAlignment','right', ... %[output:2f493917]
    'FontSize',11,'FontWeight','bold'); %[output:2f493917]

%% 6. Format figure
xlabel('Position, x [m]','FontSize',13); %[output:2f493917]
ylabel('Time, t [ms]','FontSize',13); %[output:2f493917]

title('Mach 3 Shock Reflection at a Closed Wall', ... %[output:2f493917]
    'FontSize',15,'FontWeight','bold'); %[output:2f493917]

legend([h1 h2 h3], ... %[output:2f493917]
    {'Incident shock','Reflected shock','Closed wall'}, ... %[output:2f493917]
    'Location','northwest'); %[output:2f493917]

xlim([0 1.12*L]); %[output:2f493917]
ylim([0 1e3*tEnd]); %[output:2f493917]

grid on; %[output:2f493917]
set(gca,'FontSize',12,'LineWidth',1.1, ... %[output:group:3b55fdfd] %[output:2f493917]
    'Color','w','GridAlpha',0.15); %[output:group:3b55fdfd] %[output:2f493917]

%% 7. Print results
fprintf('\n--- Shock Reflection Results ---\n'); %[output:7a017c6f]
fprintf('Incident shock speed: %.2f m/s\n',Vs); %[output:3fc2bf3b]
fprintf('Reflected shock speed: %.2f m/s\n',Vr); %[output:49ef1da7]
fprintf('Reflection time:       %.4f ms\n',1e3*tR); %[output:6f5f21a5]
fprintf('Incident pressure:     %.4f p1\n',p2_p1); %[output:35d3812b]
fprintf('Wall pressure:         %.4f p1\n',p3_p1); %[output:7813aaea]

%% 8. Optional PDF export
% exportgraphics(gcf,'Mach3_Shock_Reflection.pdf', ...
%     'ContentType','vector');

%%
